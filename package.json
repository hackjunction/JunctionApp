{
    "name": "junctionapp",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "deploy": "bunx sst deploy --stage production",
        "start": "cd backend && bun run start",
        "prod": "cd backend && bun run prod",
        "dev": "(cd frontend && bun run start) & (cd backend && bun run dev) & wait",
        "debug": "(cd frontend && bun run start) & (cd backend && bun run debug) & wait",
        "only_build": "rm -rf ./backend/build && cd frontend && bun run build && cp -r ./build ../backend/build",
        "build": "bun run setup && bun run only_build",
        "setup": "bun install && bun run setup:backend && bun run setup:frontend && bun run setup:shared",
        "loadGavelVote": "cd tests && k6 run gavelSubmitVoteStressTest.js",
        "loadGavelStartVote": "cd tests && k6 run gavelStartVoteStressTest.js",
        "dev:frontend": "cd frontend && bun run start",
        "dev:backend": "cd backend && bun run dev",
        "db-sync:prod-to-local": "sh ./scripts/sync-production-to-local.sh",
        "db-sync:prod-to-dev": "sh ./scripts/sync-production-to-dev.sh",
        "db-sync:prod-to-staging": "sh ./scripts/sync-production-to-staging.sh",
        "db-sync:dev-to-local": "sh ./scripts/sync-dev-to-local.sh",
        "pre-commit:frontend": "cd frontend && bun run precommit",
        "pre-commit:backend": "cd backend && bun run precommit",
        "pre-commit:shared": "cd shared && bun run precommit",
        "auth0": "bunx a0deploy import -c ./auth0/config.json -i ./auth0/tenant.yaml",
        "tailwind": "cd frontend && bun run build:tailwind",
        "setup:frontend": "cd frontend && bun install",
        "setup:backend": "cd backend && bun install",
        "setup:shared": "cd shared && bun install"
    },
    "pre-commit": [
        "pre-commit:frontend",
        "pre-commit:backend",
        "pre-commit:shared"
    ],
    "author": "Juuso Lappalainen",
    "license": "ISC",
    "devDependencies": {
        "pre-commit": "^1.2.2"
    },
    "dependencies": {
        "@fontsource/hanken-grotesk": "^5.0.3",
        "@fontsource/inter": "^5.0.3",
        "@google-cloud/local-auth": "^2.1.0",
        "auth0-deploy-cli": "^5.5.7",
        "forever": "^4.0.3",
        "googleapis": "^105.0.0",
        "graphql-redis-subscriptions": "^2.5.0",
        "if-env": "^1.0.4",
        "next-auth": "^4.22.1",
        "pino": "^6.3.1",
        "pino-pretty": "^4.0.0",
        "react-helmet": "^6.1.0",
        "react-pdf": "^4.1.0",
        "uuid": "^8.3.2",
        "yup": "^0.29.1"
    },
    "engines": {
        "node": "12.3.1",
        "bun": "1.3.10"
    },
    "packageManager": "bun@1.3.10",
    "type": "module"
}
